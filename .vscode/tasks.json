{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Django",
      "type": "shell",
      "command": "python manage.py runserver || py manage.py runserver",
      "isBackground": true,
      "presentation": {
        "group": "sheltersync",
        "panel": "shared"
      }
    },
    {
      "label": "Iniciar React",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/front"
      },
      "isBackground": true,
      "presentation": {
        "group": "sheltersync",
        "panel": "shared"
      }
    },
    {
      "label": "Rodar Servidores (Frontend + Backend)",
      "dependsOn": [
        "Iniciar Django",
        "Iniciar React"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}